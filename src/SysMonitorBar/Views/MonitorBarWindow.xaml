<Window x:Class="SysMonitorBar.Views.MonitorBarWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SysMonitorBar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        Topmost="{Binding AlwaysOnTop}"
        MaxWidth="{Binding MaxBarWidth}">
    <Border x:Name="DragSurface"
            CornerRadius="8"
            Padding="12,6"
            ToolTip="{Binding ToolTipText}"
            MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
        <Border.Background>
            <!-- Only the brush is translucent; the text stays fully opaque. -->
            <SolidColorBrush Color="#20242C" Opacity="{Binding BackgroundOpacity}" />
        </Border.Background>
        <TextBlock Text="{Binding RenderedText}"
                   Foreground="#F5F7FA"
                   FontFamily="Segoe UI, Yu Gothic UI"
                   FontSize="{Binding FontSize}"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" />
    </Border>
</Window>
