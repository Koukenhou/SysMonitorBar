<Window x:Class="SysMonitorBar.Views.SettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:SysMonitorBar.Core.Resources;assembly=SysMonitorBar.Core"
        Title="{x:Static res:Strings.SettingsTitle}"
        Icon="pack://application:,,,/Assets/SysMonitorBar.ico"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Yu Gothic UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,16,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <!-- Metrics -->
        <GroupBox Header="{x:Static res:Strings.SectionMetrics}">
            <StackPanel>
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Header}" Margin="0,0,0,6" />
                            <StackPanel Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding EmptyText}" Foreground="Gray" Margin="0,0,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.GpuGroupSelect}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding GpuOptions}" SelectedItem="{Binding SelectedGpu}"
                          DisplayMemberPath="Label" IsEnabled="{Binding HasGpu}" />
            </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Appearance -->
        <GroupBox Header="{x:Static res:Strings.SectionAppearance}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Static res:Strings.BackgroundOpacity}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Slider Grid.Column="1"
                        Minimum="{Binding MinOpacityPercent}"
                        Maximum="{Binding MaxOpacityPercent}"
                        Value="{Binding OpacityPercent}"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        SmallChange="5"
                        LargeChange="10"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding OpacityPercent, StringFormat={}{0}%}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="1" Text="{x:Static res:Strings.FontSize}" VerticalAlignment="Center" Margin="0,10,12,0" />
                <ComboBox Grid.Row="1" Grid.Column="1" Width="72" HorizontalAlignment="Left" Margin="0,10,0,0"
                          ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" />

                <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <CheckBox Content="{x:Static res:Strings.AlwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" />
                    <CheckBox Content="{x:Static res:Strings.ShowSeparator}" IsChecked="{Binding ShowSeparator}" />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <!-- Behavior -->
        <GroupBox Header="{x:Static res:Strings.SectionBehavior}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static res:Strings.RefreshInterval}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox Width="96" ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval}"
                              DisplayMemberPath="Label" />
                    <TextBlock Text="{x:Static res:Strings.FastIntervalWarning}" Foreground="#B45309"
                               VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowFastIntervalWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <CheckBox Content="{x:Static res:Strings.PauseWhenHidden}" IsChecked="{Binding PauseWhenHidden}" Margin="0,10,0,6" />
                <CheckBox Content="{x:Static res:Strings.StartWithWindows}" IsChecked="{Binding StartWithWindows}" />
            </StackPanel>
        </GroupBox>

        <!-- Buttons -->
        <DockPanel Margin="0,4,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" MinWidth="96" Padding="10,4" Content="{x:Static res:Strings.RestoreDefaults}"
                    Click="RestoreDefaults_Click" />
            <Button DockPanel.Dock="Right" MinWidth="80" Padding="10,4" Margin="8,0,0,0" Content="{x:Static res:Strings.Apply}"
                    IsEnabled="{Binding IsDirty}" Click="Apply_Click" />
            <Button DockPanel.Dock="Right" MinWidth="80" Padding="10,4" Margin="8,0,0,0" Content="{x:Static res:Strings.Cancel}"
                    IsCancel="True" Click="Cancel_Click" />
            <Button DockPanel.Dock="Right" MinWidth="80" Padding="10,4" Content="{x:Static res:Strings.Ok}"
                    IsDefault="True" Click="Ok_Click" />
        </DockPanel>
    </StackPanel>
</Window>
